{
  "permissions": {
    "allow": [
      "Read",
      "Edit(~/code/**)",
      "Edit(~/dotfiles/**)",
      "Edit(//private/tmp/**)",
      "WebSearch",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:learn.microsoft.com)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(nc:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh pr merge:*)",
      "Edit(~/Library/LaunchAgents/**)",
      "Edit(~/Library/LaunchDaemons/**)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Edit(~/.gnupg/**)",
      "Read(~/.config/gh/**)",
      "Edit(~/.config/gh/**)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/*.p12)",
      "Edit(**/*.pfx)"
    ],
    "ask": [
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(gh pr create:*)",
      "Bash(gh secret:*)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ],
    "defaultMode": "default"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "intility-claude-plugins": {
      "source": {
        "source": "git",
        "url": "git@github.com:intility/claude-plugins.git"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "objects.githubusercontent.com",
        "raw.githubusercontent.com",
        "codeload.github.com",
        "registry.npmjs.org",
        "*.npmjs.org",
        "api.nuget.org",
        "*.nuget.org",
        "pypi.org",
        "files.pythonhosted.org",
        "deno.land",
        "jsr.io"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/Library/Developer/Xcode/DerivedData",
        "~/Library/Caches",
        "~/Library/pnpm",
        "~/.nuget",
        "~/.dotnet",
        "~/.npm",
        "~/.cache",
        "~/.kube"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.aws",
          "mode": "deny"
        },
        {
          "path": "~/.gnupg",
          "mode": "deny"
        },
        {
          "path": "~/.config/gh",
          "mode": "deny"
        }
      ]
    },
    "excludedCommands": [
      "docker *",
      "dotnet *",
      "deno *"
    ]
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "editorMode": "normal",
  "terminalProgressBarEnabled": true,
  "skipAutoPermissionPrompt": true,
  "disableBypassPermissionsMode": "disable"
}
